# Copy to .env in this folder; docker compose picks it up automatically.
# Every value below has a working default, so .env is optional for a local
# run but MANDATORY before any deployment that is reachable from a network.

# --- Ports -------------------------------------------------------------------
FRONTEND_PORT=4560
BACKEND_PORT=4110
MONGO_PORT=27019

# --- MongoDB -------------------------------------------------------------
# A dedicated instance, separate from every other stack in this repo.
MONGO_DB=alia
MONGO_ROOT_USERNAME=alia_root
MONGO_ROOT_PASSWORD=CHANGE_ME_root
MONGO_APP_USERNAME=alia_app
MONGO_APP_PASSWORD=CHANGE_ME_app

# --- ESP32 link ----------------------------------------------------------
# The device (real firmware or the bundled simulator) pushes to us at
# POST /data - it's the client, we're the server. DEVICE_API_KEY must match
# exactly what the firmware/simulator sends as X-Device-Key.
DEVICE_API_KEY=CHANGE_ME_device_key
# If no reading arrives within this window, the link is considered down.
LINK_TIMEOUT_MS=5000
FLOW_IDLE_BELOW_MA=3.5
FLOW_OVER_ABOVE_MA=21.0
# Only used by the simulator (profile: simulator) - matches the AUF750
# controller's M55/M56 window from esp32_sample.c.
SAMPLE_INTERVAL_MS=1000
FLOW_AT_4mA=0.0
FLOW_AT_20mA=200.0

# --- CCTV (RTSP -> HLS via MediaMTX) --------------------------------------
# Full RTSP URL including credentials - lives ONLY in the alia_mediamtx
# container's env; the backend and frontend never see it. The browser only
# ever talks to /api/cctv (authenticated, credential-free HLS proxy).
# The camera must be reachable from this Docker host (same LAN, VPN, or a
# port-forward/DDNS into the site if this stack runs remotely).
CCTV_RTSP_URL=rtsp://username:password@camera-host:554/channel-path

# --- Backend -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:4560
LOG_HISTORY_SIZE=200

# --- Users & auth ----------------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_SESSION_TTL=30m
JWT_MAGIC_LINK_TTL=10m

# Used to build the clickable link embedded in the magic-link email.
APP_BASE_URL=http://localhost:4560

# Leave both SMTP_SERVICE and SMTP_HOST empty to just log magic links to the
# backend's console instead of sending real email
# (see: docker compose logs -f alia_backend).
#
# To send via Gmail:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an app password (app: "Mail"): myaccount.google.com/apppasswords
#   3. SMTP_SERVICE=gmail, SMTP_USER=<the gmail address>, SMTP_PASSWORD=<the 16-char app password>
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alia AUF750 Monitoring <no-reply@ias.local>

# Seed the first admin account on boot (only if no admin exists yet).
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@alia.local
SEED_ADMIN_PASSWORD="CHANGE_ME_Admin#12345"
SEED_ADMIN_NAME=Administrator
