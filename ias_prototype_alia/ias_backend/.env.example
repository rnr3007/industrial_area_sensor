# Copy to .env for local (non-Docker) development.
NODE_ENV=development
PORT=4110

CORS_ORIGINS=http://localhost:5173,http://localhost:4560

# The ESP32 pushes readings here (POST /data) - it's the client, we're the
# server. Must match the firmware's DEVICE_API_KEY exactly.
DEVICE_API_KEY=change-me-device-key
# If no reading arrives within this window, the link is considered down.
LINK_TIMEOUT_MS=5000

# Status thresholds, matching the AUF750 controller's 4-20mA window.
FLOW_IDLE_BELOW_MA=3.5
FLOW_OVER_ABOVE_MA=21.0

LOG_HISTORY_SIZE=200
LOG_DIR=./logs

# --- Users & auth ----------------------------------------------------------
# A dedicated MongoDB instance - separate from every other stack's Mongo.
MONGO_URI=mongodb://alia_app:alia_app_password@127.0.0.1:27019/alia?authSource=alia

JWT_SECRET=change-me-to-a-long-random-string
JWT_SESSION_TTL=30m
JWT_MAGIC_LINK_TTL=10m

# Used to build the clickable link embedded in the magic-link email.
APP_BASE_URL=http://localhost:4560

# Leave both SMTP_SERVICE and SMTP_HOST empty to just log magic links to the
# server console instead of sending real email.
#
# To send via Gmail:
#   1. Turn on 2-Step Verification on the Google account: myaccount.google.com/security
#   2. Create an app password: myaccount.google.com/apppasswords
#      (pick "Mail" as the app - Google generates a 16-character password)
#   3. SMTP_SERVICE=gmail, SMTP_USER=<the gmail address>, SMTP_PASSWORD=<the app password>
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alia AUF750 Monitoring <no-reply@ias.local>

# Seed the first admin account on boot (only if no admin exists yet).
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@alia.local
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_ADMIN_NAME=Administrator
