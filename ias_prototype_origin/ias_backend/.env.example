# Copy to .env for local (non-Docker) development.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGO_URI=mongodb://ias_app:ias_app_password@127.0.0.1:27017/ias?authSource=ias

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=12h

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=ias_service
MQTT_PASSWORD=ias_service_password
MQTT_BASE_TOPIC=ias

TCP_ENABLED=true
TCP_PORT=5027

SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@ias.local
SEED_ADMIN_PASSWORD="Admin#12345"

SNAPSHOT_TTL_SECONDS=21600
