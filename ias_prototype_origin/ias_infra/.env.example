# Copy to .env in this folder; docker compose picks it up automatically.
# Every value below has a working default, so .env is optional for a local run
# but MANDATORY before any deployment that is reachable from a network.

# --- Ports -------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=4000
TCP_PORT=5027
MQTT_PORT=1883
MQTT_WS_PORT=9001
MONGO_PORT=27017

# --- MongoDB -----------------------------------------------------------------
MONGO_DB=ias
MONGO_ROOT_USERNAME=ias_root
MONGO_ROOT_PASSWORD=CHANGE_ME_root
MONGO_APP_USERNAME=ias_app
MONGO_APP_PASSWORD=CHANGE_ME_app

# --- MQTT broker -------------------------------------------------------------
MQTT_SERVICE_USER=ias_service
MQTT_SERVICE_PASSWORD=CHANGE_ME_service
MQTT_DEVICE_USER=ias_device
MQTT_DEVICE_PASSWORD=CHANGE_ME_device
MQTT_BASE_TOPIC=ias

# --- Backend -----------------------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_ACCESS_TTL=12h
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
SNAPSHOT_TTL_SECONDS=21600

# Seed the admin account and demo sites on first boot.
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@ias.local
SEED_ADMIN_PASSWORD="CHANGE_ME_Admin#12345"

# --- Frontend (baked in at build time) ---------------------------------------
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=
# Optional vector basemap; empty uses the key-free OSM raster tiles.
VITE_MAP_STYLE_URL=

# --- Simulator (profile: simulator) ------------------------------------------
SIM_COMPANIES=PTAJ,PTBKN,PTSLP,PTHPS
SIM_INTERVAL_MS=5000
SIM_SNAPSHOT_EVERY=6
SIM_BACKFILL_HOURS=48
SIM_ANOMALY_CHANCE=0.04
