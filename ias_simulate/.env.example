# Copy to .env for local (non-Docker) runs: node --env-file=.env src/simulator.js
# (or src/rubber-dam-simulator.js - see below)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=ias_device
MQTT_PASSWORD=ias_device_password
MQTT_BASE_TOPIC=ias

# Comma separated company codes to simulate - each gets its own independent
# water-level/flow/quality baseline that drifts over time.
SIM_COMPANIES=PTAJ,PTBKN,PTSLP,PTHPS
SIM_INTERVAL_MS=5000
SIM_SNAPSHOT_EVERY=6
SIM_BACKFILL_HOURS=48
SIM_ANOMALY_CHANCE=0.04

# --- Rubber Dam prototype simulator (src/rubber-dam-simulator.js) ---
# Uses its own MQTT_URL/MQTT_USERNAME/MQTT_PASSWORD when run against the
# ias_prototype stack's own broker (see ias_prototype/ias_infra).
RUBBERDAM_BASE_TOPIC=rubberdam
RUBBERDAM_TICK_MS=1000
