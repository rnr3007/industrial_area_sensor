# Vite reads these at BUILD time (they are baked into the bundle).
# Leave empty to use the same origin - which is what the nginx container does.

# REST API base path or absolute URL
VITE_API_BASE_URL=/api

# Socket.IO origin; empty means window.location.origin
VITE_SOCKET_URL=

# Optional vector basemap style (e.g. a MapTiler or Mapbox style URL with key).
# Leaving it empty uses the key-free OpenStreetMap raster basemap.
VITE_MAP_STYLE_URL=

# Backend target for `npm run dev` only
VITE_DEV_API=http://localhost:4000
