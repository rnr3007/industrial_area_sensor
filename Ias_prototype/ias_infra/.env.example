# Copy to .env in this folder; docker compose picks it up automatically.
# Every value below has a working default, so .env is optional for a local run
# but MANDATORY before any deployment that is reachable from a network.

# --- Ports -------------------------------------------------------------------
FRONTEND_PORT=4546
BACKEND_PORT=4100
MQTT_PORT=1884
MQTT_WS_PORT=9002

# --- MQTT broker -------------------------------------------------------------
MQTT_SERVICE_USER=rubberdam_service
MQTT_SERVICE_PASSWORD=CHANGE_ME_service
MQTT_DEVICE_USER=rubberdam_device
MQTT_DEVICE_PASSWORD=CHANGE_ME_device
RUBBERDAM_BASE_TOPIC=rubberdam

# --- Backend -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:4546
LOG_HISTORY_SIZE=200

# --- Users & auth --------------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_SESSION_TTL=30m
JWT_MAGIC_LINK_TTL=10m

# Used to build the clickable link embedded in the magic-link email.
APP_BASE_URL=http://localhost:4546

# Leave both SMTP_SERVICE and SMTP_HOST empty to just log magic links to the
# backend's console instead of sending real email
# (see: docker compose logs -f iasproto_backend).
#
# To send via Gmail:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Create an app password (app: "Mail"): myaccount.google.com/apppasswords
#   3. SMTP_SERVICE=gmail, SMTP_USER=<the gmail address>, SMTP_PASSWORD=<the 16-char app password>
#      Gmail rejects the normal account password for SMTP login. SMTP_HOST/
#      PORT/SECURE are ignored when SMTP_SERVICE is set.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IAS Rubber Dam <no-reply@ias.local>

# Seed the first admin account on boot (only if no admin exists yet).
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@rubberdam.local
SEED_ADMIN_PASSWORD="CHANGE_ME_Admin#12345"
SEED_ADMIN_NAME=Administrator

# --- Simulator (profile: simulator) ------------------------------------------
RUBBERDAM_TICK_MS=1000
