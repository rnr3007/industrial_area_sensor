# Copy to .env for local (non-Docker) development.
NODE_ENV=development
PORT=4100

CORS_ORIGINS=http://localhost:5173,http://localhost:4546

MQTT_URL=mqtt://127.0.0.1:1884
MQTT_USERNAME=rubberdam_service
MQTT_PASSWORD=rubberdam_service_password
MQTT_BASE_TOPIC=rubberdam

LOG_HISTORY_SIZE=200

# Where logs/info.txt and logs/error.txt are written. Defaults to ./logs
# (relative to the process cwd) if unset.
LOG_DIR=./logs

# --- Users & auth --------------------------------------------------------
# A dedicated MongoDB instance - separate from the main IAS platform's Mongo,
# so the two stacks never share a database.
MONGO_URI=mongodb://rubberdam_app:rubberdam_app_password@127.0.0.1:27018/rubberdam?authSource=rubberdam

JWT_SECRET=change-me-to-a-long-random-string
JWT_SESSION_TTL=30m
JWT_MAGIC_LINK_TTL=10m

# Used to build the clickable link embedded in the magic-link email.
APP_BASE_URL=http://localhost:4546

# Leave both SMTP_SERVICE and SMTP_HOST empty to just log magic links to the
# server console instead of sending real email - fine for local development.
#
# To send via Gmail:
#   1. Turn on 2-Step Verification on the Google account: myaccount.google.com/security
#   2. Create an app password: myaccount.google.com/apppasswords
#      (pick "Mail" as the app - Google generates a 16-character password)
#   3. SMTP_SERVICE=gmail, SMTP_USER=<the gmail address>, SMTP_PASSWORD=<the app password>
#      Gmail rejects the normal account password for SMTP login - it must be
#      an app password. SMTP_HOST/PORT/SECURE are ignored when SMTP_SERVICE is set.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IAS Rubber Dam <no-reply@ias.local>

# Seed the first admin account on boot (only if no admin exists yet).
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@rubberdam.local
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_ADMIN_NAME=Administrator
